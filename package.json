{
  "name": "distributed-wagering-processor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test test/money.test.ts test/wallet.test.ts test/hash.test.ts ./test/domain-transitions.test.ts ./test/test-safety.test.ts",
    "test:integration": "bun test test/integration.test.ts",
    "test:race": "bun scripts/race.ts",
    "test:3instances": "bun scripts/race-three.ts",
    "migration:up": "bunx mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "bunx mikro-orm migration:down --config ./mikro-orm.config.ts",
    "migration:pending": "bunx mikro-orm migration:pending --config ./mikro-orm.config.ts",
    "start:worker": "bun src/worker-main.ts",
    "queues:init": "bun scripts/init-queues.ts",
    "test:messaging": "bun test test/messaging.test.ts",
    "test:references": "bun test test/references.test.ts",
    "test:parallel-wallets": "bun test test/parallel-wallets.test.ts",
    "test:crash-recovery": "bun test test/worker-crash-recovery.test.ts",
    "test:sigterm": "bun test test/worker-sigterm.test.ts",
    "test:consumer-retry": "bun test test/consumer-retry-dlq.test.ts",
    "test:consumer-dlq-persistent": "bun test test/consumer-dlq-persistent.test.ts",
    "test:all": "bun scripts/test-isolated.ts",
    "demo:sqs": "bun scripts/demo-sqs.ts",
    "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "test:isolated": "bun scripts/test-isolated.ts",
    "test:inbox-replay": "bun test ./test/inbox-replay.test.ts",
    "test:atomicity": "bun test ./test/atomicity.test.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.0.0",
    "@mikro-orm/decorators": "^7.0.0",
    "@mikro-orm/migrations": "^7.0.0",
    "@mikro-orm/nestjs": "^7.0.0",
    "@mikro-orm/postgresql": "^7.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "dotenv": "^16.6.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.0.0",
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0",
    "@oxc-node/core": "^1.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ],
    "preferTs": true,
    "tsLoader": "oxc"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
