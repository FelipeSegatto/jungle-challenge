# Nenhum segredo aqui. Só a URL de cada instância do backend que o proxy do Vite usa.
# Valores abaixo são os defaults de vite.config.ts (porta do docker-compose.yml: api1/api2/api3).
# Troque só se as instâncias estiverem em outras portas (ex.: rodando `bun run start` solto fora do Docker).
VITE_NODE_1_TARGET=http://127.0.0.1:3001
VITE_NODE_2_TARGET=http://127.0.0.1:3002
VITE_NODE_3_TARGET=http://127.0.0.1:3003
